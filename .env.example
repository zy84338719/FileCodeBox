# FileCodeBox Docker Compose 生产环境变量示例
# 复制本文件为 .env 并填写真实值后运行: docker compose -f docker-compose.prod.yml up -d

# JWT 签名密钥（全环境必填！开发也必须设置，启动时会 fail-fast 校验）
# 生成方式: openssl rand -hex 32
# 注意：禁止使用 please-change-me / dev-only 等占位值，会被拒绝启动
JWT_SECRET=

# metrics 默认关闭；开启时绑定内网地址（同节点 Prometheus 抓取）
# FCB_METRICS_ENABLED=true
# FCB_METRICS_ADDR=127.0.0.1:9090

# Redis 密码（留空则无密码，生产建议设置）
REDIS_PASSWORD=

# 数据库密码（仅在使用 MySQL 时需要）
DB_PASSWORD=
DB_ROOT_PASSWORD=
