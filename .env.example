# FileCodeBox Docker Compose 生产环境变量示例
# 复制本文件为 .env 并填写真实值后运行: docker compose -f docker-compose.prod.yml up -d

# JWT 签名密钥（必填！生产环境必须改为强随机值）
# 生成方式: openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-strong-random-string

# Redis 密码（留空则无密码，生产建议设置）
REDIS_PASSWORD=

# 数据库密码（仅在使用 MySQL 时需要）
DB_PASSWORD=
DB_ROOT_PASSWORD=
